<%-include('partials/header') %>

  <main class="game-wrapper">
    <div class="game-card-container">
      
   
      <div class="d-flex justify-content-between align-items-center mb-3 px-2">
        <div class="bg-white px-4 py-2 rounded-pill shadow-sm fw-bold fs-5 text-dark border">
          🏆 Score: <span class="text-primary"><%= locals.counter %></span>
        </div>

        <% if (locals.quizStarted && locals.quizAnswer && !locals.correct && !locals.gameOver) { %>
        <div class="bg-white px-4 py-2 rounded-pill shadow-sm fw-bold fs-5 text-dark border">
          ⏱️ Time: <span id="timer" class="text-danger"><%= locals.timer %></span>s
        </div>

        <span id="quiz-active"></span>
        <form id="timeout-form" action="/game-over" method="post" class="d-none">
          <input type="hidden" name="gameOver" value="true">
          <input type="hidden" name="timeout" value="true">
        </form>
        <% } %>
      </div>

  
      <section class="game-card text-center">

        <% if (!locals.quizStarted && !locals.gameOver && !locals.correct) { %>
          
          <div class="start-screen py-4">
            <div class="result-icon">🐾</div>
            <h1 class="display-5 fw-bold mb-3">What's My Name?</h1>
            <p class="fs-5 text-muted mb-4">Can you identify the animal before time runs out?</p>
            <form action="/start-quiz" method="post">
              <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fs-4 fw-bold shadow" name="quizStarted" value="true">
                Start Game 🚀
              </button>
            </form>
          </div>

        <% } else if (locals.gameOver && !locals.correct) { %>

        
        
          <div class="result-screen py-4">
           
      
            <div id="outcomeIcon" class="result-icon wrong-icon"><%= locals.timeout ? "⏰" : "❌" %></div>
            <h1 class="display-4 fw-bold text-danger mb-2">Game Over!</h1>
            <p id="outcomeP" class="fs-4 text-muted"><%= locals.timeout ? "Time's up!" : "Better Luck Next Time!" %></p>
            
            <div class="info-box my-4 text-center fs-5">
              <span class="text-muted">The correct answer was</span><br>
              <strong class="text-dark fs-3"><%= locals.quizAnswer[0].Name %></strong>
            </div>

            <div class="bg-light rounded-pill d-inline-block px-5 py-3 mb-4 border">
              <span class="fs-5 text-muted me-2">Final Score</span>
              <strong class="fs-2 text-primary"><%= locals.counter %></strong>
            </div>
            <%if (locals.counter>0){%>
            <div>
              <span class="info-box my-4 text-center fs-5">You got <%= locals.correctAnswers.length %> correct:</span>
              <strong class="fs-5 text-success"><%= locals.correctAnswers.join(', ') %></strong>
            </div>
            <% } else { %>
            <div>
              <span class="info-box my-4 text-center fs-5">You got <strong class="fs-5 text-warning">no answers</strong> correct</span>
              
            </div>
            <% } %>

            <form action="/reset-quiz" method="post">
              <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow">
                Play Again 🔄
              </button>
            </form>
          </div>
             <% } else if (locals.gameOver && locals.correct) { %>
        
          <div class="result-screen py-4">
            <div class="result-icon correct-icon">🎉</div>
            <h1 class="display-4 fw-bold text-success mb-2">Congratulations!</h1>
            <p class="fs-4 text-muted">You've completed the quiz!</p>
            <p>You got <%= locals.correctAnswers.length%> out of <%= locals.counter %> correct!</p>
           
            
            <div class="info-box my-4 text-center fs-5">
              <span class="text-muted">The correct answer was</span><br>
              <strong class="text-dark fs-3"><%= locals.quizAnswer[0].Name %></strong>
            </div>
  
            <div class="bg-light rounded-pill d-inline-block px-5 py-3 mb-4 border">
              <span class="fs-5 text-muted me-2">Final Score</span>
              <strong class="fs-2 text-primary"><%= locals.counter %></strong>
            </div>
            <div>
              <span class="info-box my-4 text-center fs-5">Animals you named correctly: </span>
              <strong class="fs-5 text-success"><%= locals.correctAnswers %></strong>
            </div>

            <form action="/reset-quiz" method="post">
              <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow">
                Play Again 🔄
              </button>
            </form>
          </div>

        <% } else if (locals.correct) { %>
         
          <div class="result-screen py-2">
            <div class="result-icon correct-icon">✨</div>
            <h1 class="display-5 fw-bold text-success mb-1">Correct!</h1>
            <h2 class="h3 mb-4"><%= locals.quizAnswer[0].Name %></h2>

            <div class="info-box mb-4">
              <p class="mb-2">
                <strong class="text-primary">📝 Description:</strong><br>
                <span class="text-muted"><%= locals.quizAnswer[0].Description %></span>
              </p>
              <p class="mb-0">
                <strong class="text-success">🌍 Habitat:</strong><br>
                <span class="text-muted"><%= locals.quizAnswer[0].Habitat %></span>
              </p>
            </div>
            
            <form action="/next-question" method="post">
              <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 fw-bold shadow w-100">
                Next Question ➔
              </button>
            </form>
          </div>

        <% } else if (locals.quizStarted && locals.quizAnswer) { %>
          
          <div class="question-section">
            <h2 class="fw-bold mb-3">What animal is this?</h2>
            <img src="<%= locals.quizAnswer[0].URL %>" alt="<%= locals.quizAnswer[0].Name %>" class="animal-image">
          </div>
        <% } %>

      
        <% if (locals.quizStarted && locals.namesChoice && !locals.correct && !locals.gameOver) { %>
          <div class="answers-section mt-4">
            <form action="/check-answer" method="post">
              <div class="row g-3">
                <% locals.namesChoice.forEach(function(name, index) { %>
                  <div class="col-12 col-sm-6">
                    <button type="submit" class="btn btn-outline-primary w-100 py-3 rounded-4 fs-5 fw-bold d-flex align-items-center answer-btn" name="userAnswer" value="<%= name %>">
                      <span class="answer-letter"><%= String.fromCharCode(65 + index) %></span> 
                      <%= name %>
                    </button>
                  </div>
                <% }); %>
              </div>
            </form>
          </div>
        <% } %>


        <% if (!locals.gameOver && locals.quizStarted && !locals.correct) { %>
          <div class="d-flex justify-content-center gap-3 mt-4 pt-3 border-top">
            <form action="/skip-question" method="post">
              <button type="submit" class="btn btn-light fw-bold px-4 rounded-pill border">
                Skip ⏭️
              </button>
            </form>
            <form action="/reset-quiz" method="post">
              <button type="submit" class="btn btn-light text-danger fw-bold px-4 rounded-pill border">
                Reset 🛑
              </button>
            </form>
          </div>
        <% } %>

      </section>
    </div>
  </main>

<%- include('partials/footer') %>
  

  <script>
    const quiz = document.getElementById("quiz-active");
    
    if (quiz) {
      let timer = 30; // Starts at 30
  
      const display = document.getElementById("timer");
      function updateGameState() {
        if (timer <= 0) {
          
          clearInterval(timerInterval);
          document.getElementById("timeout-form").submit();
         
        }
      }
      
      const timerInterval = setInterval(function () {
        timer--;
        display.textContent = timer;
        
        if (timer <= 10) {
           display.classList.add('text-danger', 'fw-bold');
        }

        if (timer <= 0) {
          updateGameState();
        }
      }, 1000);
    }
  </script>
 

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>