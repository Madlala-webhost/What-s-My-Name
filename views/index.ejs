<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>What's My Name</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DynaPuff:wght@400..700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/styles.css" />
    <style>
      body {
        font-family: "DynaPuff", cursive;
      
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg bg-white shadow-sm rounded-4  px-5">
      <div class="container-fluid">
        <a class="navbar-brand brand-title px-3" href="/">
          <img
            src="https://res.cloudinary.com/dvpva0mcr/image/upload/v1785786534/logo_nvd4ow.png"
            alt="What's My Name"
            height="60"
            width="auto"
          />
          <h5>What's My Name</h5></a
        >

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarContent"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarContent">
          <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link" href="/">Play</a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/leaderboard">Leaderboard</a>
            </li>
          </ul>

          <!-- Right Side -->
          <div class="d-flex px-5">
            <a href="/login" class="btn btn-warning rounded-pill px-5">
              Login
            </a>
          </div>
        </div>
      </div>
    </nav>
    <div
      class="container mt-5 text-center"
      style="
        height: 650px;
        justify-content: center;
        align-items: center;
        width: 50%;
      "
    >
      <div class="header text-center col-4 offset-10 rounded w-50">
        <h2>Score: <%= locals.counter %></h2>
      </div>
      <div
        class="header bg-warning text-center justify-content-center col-12 rounded mb-3"
      >
        <h2 class="mt-3">A fun game to test your knowledge of animals</h2>
        Count down timer: <span id="timer">30</span> seconds
      </div>

      <div class="body text-center d-flex justify-content-center col-12">
        <div class="card mb-3 bg-light rounded p-3 col-5 justify-content-center align-items-center">
          <% if (!locals.quizStarted) { %>
          <form action="/start-quiz" method="post">
            <button type="submit" class="btn btn-warning" name="quizStarted" value="true">
              <h2>Press To Start</h2>
            </button>
          </form>
          <% } else if (locals.gameOver) { %>
            <h2 style="color: red;">Game Over!</h2>
            <p style="color: red;">Your final score is: <%= locals.counter %></p>
            <form action="/start-quiz" method="post">
              <button type="submit" class="btn btn-warning" name="quizStarted" value="true">
                <h2>Play Again</h2>
              </button>
            </form>
          <% } else { %>
            <h2>Quiz Started!</h2>
          <% } %>
        </div>
        <% if(locals.quizStarted && locals.quizAnswer) { %>
        <div class="card mb-3 bg-light rounded p-3 col-5 offset-1"><img style="height: 300px; width: auto; border-radius: 10%;" src="<%= locals.quizAnswer[0].URL %>" alt="<%= locals.quizAnswer[0].Name %>" class="img-fluid" /></div>
        
        <% } %>
      </div> 
        
      
        
        <div class="card mb-3 bg-light rounded p-3 col-12 justify-content-center align-items-center">
          <% if(locals.quizStarted && locals.namesChoice && !locals.isCorrect) { %>
          <form action="/check-answer" method="post">
            <% locals.namesChoice.forEach(function(name, index) { %>
              <button type="submit" class="btn btn-warning mb-2" name="userAnswer" value="<%= name %>" >
                <h2><%= name %></h2>
              </button>
            <% }); %>
          </form>
        </div>
        <% } %>
      <div class="text-center mt-3 d-flex justify-content-center col-12">
        <% if (locals.quizStarted && !locals.gameOver) { %>
        <div class="btn btn-primary col-5">Reset</div>
        <div class="btn btn-secondary col-5 offset-1">Skip</div>
        <% } %>
      </div>
    </div>
    
    <footer
      class="footer mt-2  border-top bottom-0 start-0 end-0 position-absolute"
      style="
        background: linear-gradient(135deg, #1a252f 75%, #0f171d 100%);
        color: #ffffff; ;
      "
    >
      <div class="container position-relative">
        <div class="border-top border-secondary">
          <div class="row py-4">
            <div class="col-md-6">
              <p class="mb-0 text-white-50 small">
                © 2026 What's My Name. All rights reserved.
              </p>
            </div>
            <div class="col-md-6 text-md-end">
              <p class="mb-0 text-white-50 small">
                Made with <i class="bi bi-heart-fill"></i> by
                <span class="text-warning fw-semibold"> Njabulo </span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </footer>
    <script src="/script.js"></script>
  </body>
  
</html>
